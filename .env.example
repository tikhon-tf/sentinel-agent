# Nebius AI Studio — inference (required)
NEBIUS_API_KEY=

# OpenAI — Act 1 model (optional)
OPENAI_API_KEY=

# Pinecone — SOP corpus retrieval (required)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sentinel-sops

# Pinecone Nexus — regulation knowledge base (Act 2)
NEXUS_API_KEY=
NEXUS_BASE_URL=https://prod.nexus.pinecone.io
NEXUS_CONTEXT_SLUG=sentinel-regs-test
# Set to false to use Pinecone RAG instead of Nexus for Act 2
USE_NEXUS=true

# Tavily — live regulation grounding (required)
TAVILY_API_KEY=

# LangSmith — observability (optional, auto-enabled when set)
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=sentinel-agent

# Snowglobe / Guardrails AI — adversarial simulation (Act 3 only)
SNOWGLOBE_API_KEY=

# Jira — Act 4 actuation. Fill in per your own Jira deployment.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
